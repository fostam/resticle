# An encrypted secrets.yaml is meant to be committed; .githooks/pre-commit
# refuses one that is not encrypted. The env-file fallback is always
# plaintext, so it stays ignored.
*.env
/resticle
/dist/

# A live host config belongs on the host, not in the repository. Anchored to
# the root on purpose: an unanchored pattern also swallows testdata/config.yaml.
/config.yaml
